{
  "outputDirectory": "public",
  "buildCommand": "node tools/build-brands.js",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?voyporvenezuela\\.com" }],
      "status": 308,
      "headers": { "Location": "https://juntosayudando.com/$1" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "juntosporcolombia\\.fundacionfalcao\\.org" }],
      "dest": "/colombia.html"
    },
    { "handle": "filesystem" }
  ]
}
